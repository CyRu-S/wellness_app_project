{
  "name": "wellness-app-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client --lan",
    "start:lan": "expo start --dev-client --lan",
    "start:go": "expo start --go --lan",
    "android": "expo run:android",
    "start:android": "expo start --dev-client --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:store": "eas build --platform android --profile production",
    "submit:android:store": "eas submit --platform android --profile production --latest",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "build:web": "node scripts/build-web.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@reduxjs/toolkit": "^2.12.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4"
  }
}
