# Physical phone: use the computer's LAN address. Web can use localhost.
# Optional shared fallback. Platform-specific values below take precedence.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api
EXPO_PUBLIC_WEB_API_URL=http://localhost:8080/api
EXPO_PUBLIC_MOBILE_API_URL=http://192.168.1.10:8080/api
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Optional Google OAuth clients; corresponding backend GOOGLE_CLIENT_IDS required.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android push: EAS project UUID; Firebase Android app config (NOT a service-account key).
EXPO_PUBLIC_EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=./google-services.json
# Optional Expo account/organization that owns this app.
EXPO_OWNER=
