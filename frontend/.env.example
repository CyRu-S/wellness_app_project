# Use your computer's LAN address when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api
EXPO_PUBLIC_API_TIMEOUT_MS=5000

# false: the two documented demo accounts use instant on-device fixtures.
# true: those same accounts authenticate against the seeded backend.
EXPO_PUBLIC_USE_API_DEMO_ACCOUNTS=false

# Set true for production-style builds so registration never falls back to local demo state.
EXPO_PUBLIC_DISABLE_DEMO_FALLBACK=false

# Optional live image-analysis endpoint.
EXPO_PUBLIC_MEAL_ANALYSIS_URL=
