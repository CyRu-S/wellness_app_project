{
  "expo": {
    "name": "Arjun Nutrition",
    "slug": "wellnest",
    "version": "0.1.0",
    "icon": "./assets/images/arjun-nutrition-logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/arjun-nutrition-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#002E36"
    },
    "android": {
      "package": "com.wellnessapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/arjun-nutrition-logo.png",
        "backgroundColor": "#002E36"
      }
    },
    "ios": {
      "bundleIdentifier": "com.wellnessapp.mobile",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Arjun Nutrition to photograph meals for nutrition analysis.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Arjun Nutrition to select meal photos for nutrition analysis.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
