{
  "expo": {
    "name": "Wellnest",
    "slug": "wellnest",
    "version": "0.1.0",
    "icon": "./assets/app-logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F4F1E8"
    },
    "android": {
      "package": "com.wellnessapp.mobile",
      "icon": "./assets/app-logo.png",
      "adaptiveIcon": {
        "backgroundColor": "#193C34"
      }
    },
    "ios": {
      "bundleIdentifier": "com.wellnessapp.mobile",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
